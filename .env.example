# Copy to .env and edit. .env is git-ignored: never commit it.

# Ollama on the AI workstation
OLLAMA_BASE_URL=http://192.168.1.240:11434/v1
DEFAULT_MODEL=qwen3:8b
FAST_MODEL=llama3.2:3b
REASONING_MODEL=deepseek-r1:8b

# Cloud model: off for now. If you turn it on later, it is still never used for client data.
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
